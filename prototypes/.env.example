# Shared environment for every prototype under prototypes/.
# Copy to prototypes/.env (gitignored). Each prototype's CLI loads its own ./.env first,
# then this file, then the process environment already set wins over both.

# OpenRouter key used by the default "openrouter:<model>" model strings
# (packer harness, fmp-agent, ibm-memory agent).
OPENROUTER_API_KEY=

# Optional: use another provider via LangChain init_chat_model strings, e.g.
#   --model anthropic:claude-sonnet-4-6   needs ANTHROPIC_API_KEY
#   --model openai:gpt-5                  needs OPENAI_API_KEY
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
